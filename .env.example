# sitemill が読む環境変数の一覧。実際の値は各サービス（akiya-atlas など）の .env に手で書く。
# このリポジトリ自体は値を持たない。`op://...` のような未解決の参照が入っていると起動時に止まる。
ANTHROPIC_API_KEY=
GOOGLE_MAPS_EMBED_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_WEB_ANALYTICS_TOKEN=
# Google Search Console のメタタグ方式トークン（無ければ出力しない。ファイル方式は verification/ を使う）
GOOGLE_SITE_VERIFICATION=
# LLM プロバイダの上書き（既定は site.toml の [llm] provider）。anthropic | fixture。例示でも値は書かない
SITEMILL_LLM_PROVIDER=
