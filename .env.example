# sitemill が読む環境変数の一覧。実際の値は各サービス（akiya-atlas など）の .env に手で書く。
# このリポジトリ自体は値を持たない。`op://...` のような未解決の参照が入っていると起動時に止まる。
ANTHROPIC_API_KEY=
GOOGLE_MAPS_EMBED_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_WEB_ANALYTICS_TOKEN=
# LLM プロバイダ: anthropic | fixture（テスト用。tests/fixtures の応答を返す）
SITEMILL_LLM_PROVIDER=anthropic
